 #include "BuffersStorage.h"
 #include "Connection.h"
 
+// === Adaptive DPI-evasion layer: micro-fragmentation of the first handshake packet ===
+#include "DpiEvasion.h"
+
+// Sends the FIRST packet of a connection in micro-fragments so DPI boxes
+// cannot match the MTProto Obfuscated2 / FakeTLS handshake signature in a
+// single TCP segment. Chunk sizes/delays come from the DpiEvasion module
+// and auto-escalate when handshakes start failing.
+static ssize_t dpiFragSend(int socketFd, uint8_t *data, size_t size, bool &firstPacketDone) {
+    tgnet::DpiEvasion::Plan plan = tgnet::DpiEvasion::planFor();
+    if (firstPacketDone || plan.chunk1 == 0 || size <= plan.chunk1 + plan.chunk2) {
+        return send(socketFd, data, size, 0);
+    }
+    ssize_t s1 = send(socketFd, data, plan.chunk1, 0);
+    if (s1 < 0) return s1;
+    if ((size_t) s1 < plan.chunk1) {
+        firstPacketDone = true;
+        return s1;
+    }
+    usleep(plan.delayUs);
+    ssize_t s2 = send(socketFd, data + plan.chunk1, plan.chunk2, 0);
+    firstPacketDone = true;
+    if (s2 <= 0) return s1;
+    usleep(plan.delayUs);
+    size_t head = plan.chunk1 + s2;
+    ssize_t s3 = send(socketFd, data + head, size - head, 0);
+    if (s3 < 0) return (ssize_t) head;
+    return (ssize_t) (head + s3);
+}
+// === end adaptive DPI-evasion layer ===
